# Entorno y Servidor
NODE_ENV="development"
PORT=3000

# Modo de Ejecución (Shadow Trading / Dry-Run vs Producción Real)
DRY_RUN="true"                 # true = Shadow Trading (sin dinero real); false = Producción en vivo

# Parámetros del Grid Adaptativo (ATR)
GRID_SYMBOL="BTC/USDT"
GRID_LEVELS="20"
GRID_INVESTMENT="2000.00"      # Capital inicial de grilla ($1000 USDT + $1000 USD en BTC)
ATR_PERIOD="14"                # Período clásico para evaluar volatilidad
ATR_TIMEFRAME="1h"             # Velas de 1 hora para calcular la expansión/compresión
ATR_MULTIPLIER="6.0"           # Multiplicador del ATR para calcular el ancho de grilla
MIN_GRID_RANGE_USD="4000.00"   # Techo mínimo de compresión en baja volatilidad ($4000 USD total = +- $2000 USD)
MAX_GRID_RANGE_USD="6000.00"   # Tope máximo de expansión en alta volatilidad

# Cortacircuitos de Velocidad (Circuit Breaker)
CIRCUIT_BREAKER_DROP_PCT="5.0"        # Porcentaje de caída para disparar freno (5%)
CIRCUIT_BREAKER_WINDOW_MINS="15"      # Ventana temporal de velocidad (15 min)
CIRCUIT_BREAKER_COOLDOWN_HOURS="2.0"   # Pausa de compras tras Flash Crash (2 horas)

# Bloqueo FOMO (Escudo Anti-Comprar la Cima de un Pump)
FOMO_COOLDOWN_HOURS="4.0"             # Enfriamiento tras romper el techo de la grilla (4 horas)

# Guardián de Deriva Proactiva de Precio (Price Drift Trigger)
PRICE_DRIFT_UPPER_THRESHOLD="0.80"     # Umbral superior (80% del rango de la grilla)
PRICE_DRIFT_LOWER_THRESHOLD="0.20"     # Umbral inferior (20% del rango de la grilla)
PRICE_DRIFT_COOLDOWN_MINS="15"         # Cooldown de recentrado proactivo (15 min)

# Parámetros de Gestión de Riesgo (Escalables dinámicamente)
MAX_ORDER_VALUE_USD="1000.00"   # Límite individual por orden (escala con inyección de capital)
MAX_GRID_ALLOCATION_USD="10000.00" # Blindaje máximo asignable a la grilla abierta
MAX_OPEN_ORDERS="20"

# Firewall de Autodefensa de Capital y Alerta de Sed (Binance Simple Earn Flexible)
ENABLE_AUTO_INJECT="false"             # false = Primer mes sin tocar fondo de reserva; true = Habilitado
STARVATION_THRESHOLD_USD="150.00"      # Umbral de disponible en USDT para evaluar sed
AUTO_INJECT_COOLDOWN_DAYS="20"          # Días mínimos de cooldown entre inyecciones
AUTO_INJECT_AMOUNT_USD="1000.00"        # Monto a rescatar de Simple Earn Flexible por evento
MAX_LIFETIME_ALLOCATION_USD="2000.00"   # Techo patrimonial asignado (primer mes = $2000 USD)

# Alertas y Observabilidad (Slack Notifications & Kill-Switch)
ENABLE_NOTIFICATIONS="true"
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"

# Base de Datos PostgreSQL (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/grid_bot?schema=public"

# Credenciales de API Exchange (Binance Testnet / Sandbox para pruebas en vivo)
EXCHANGE_ID="binance"
EXCHANGE_API_KEY="mock_api_key"
EXCHANGE_API_SECRET="mock_api_secret"
EXCHANGE_TESTNET="true"
